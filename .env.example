# Copy to .env.local for development. Never commit real secrets.

# --- Public site settings -------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.mariamkaldas.com
# Calendly event used by the embedded scheduler (verified: calendly.com/kaldas/sample returns 200).
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/kaldas/sample
# Optional cookieless analytics (leave empty to load nothing).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Contact form delivery (/api/contact) ---------------------------------
# Provider 1: Resend (preferred). Verify the sending domain in Resend first.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Mariam Kaldas Website <hello@send.mariamkaldas.com>"
CONTACT_TO_EMAIL=me@mariamkaldas.com

# Provider 2: Nodemailer over SMTP (used only when RESEND_API_KEY is empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Development helper: accept submissions and log them instead of sending.
CONTACT_DRY_RUN=
