# Copy to .env.local for development. Never commit real secrets.

# --- Public site settings -------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.mariamkaldas.com
# Default Calendly event (verified: calendly.com/kaldas/sample returns 200). The live link is edited at
# /admin -> Booking & Contact; this value is only the starting point and what "Reset to Defaults" restores.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/kaldas/sample
# Optional cookieless analytics (leave empty to load nothing).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Contact form delivery (/api/contact) ---------------------------------
# Provider 1: Resend (preferred). Verify the sending domain in Resend first.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Mariam Kaldas Website <hello@send.mariamkaldas.com>"
CONTACT_TO_EMAIL=me@mariamkaldas.com

# Provider 2: Nodemailer over SMTP (used only when RESEND_API_KEY is empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Development helper: accept submissions and log them instead of sending.
CONTACT_DRY_RUN=

# --- Admin portal (/admin) ---------------------------------------------------
# The one secret Mariam signs in with. Without it /admin shows "not switched on" and nobody can sign in.
# Use a long passphrase (16+ characters). Changing it signs every active session out.
ADMIN_PASSWORD=
# Optional. A separate random string (32+ characters) used to sign session cookies. If empty, the signing key is
# derived from ADMIN_PASSWORD. Generate one with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Where edits are saved. Set ONE pair. On Vercel, adding the Upstash Redis integration (Project -> Storage) sets the
# KV_REST_API_* pair for you. Locally, leave both empty: edits are saved to data/site-content.json instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local development only: use a different file than data/site-content.json (handy for tests).
CMS_DATA_FILE=
